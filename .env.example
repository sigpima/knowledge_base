# Sao chép thành .env rồi sửa. Giá trị dưới đây chỉ dành cho demo trên máy cá nhân.

# Kết nối có quyền ghi (service ingest, seed)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/knowledge_base

# Kết nối chỉ đọc (MCP server). Tạo role bằng: RO_PASSWORD=change-me python -m scripts.init_db
DATABASE_URL_READONLY=postgresql+psycopg2://knowledge_base_ro:change-me@localhost:5432/knowledge_base

# Service ingest (mặc định chỉ lắng nghe 127.0.0.1)
# API_HOST=127.0.0.1

# MCP server
# MCP_SERVER_HOST=127.0.0.1
# MCP_SERVER_PORT=8002

# Bot chat trong terminal (python -m app.chat) -- tuỳ chọn, cần khoá Gemini
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
# MCP_SERVER_URL=http://127.0.0.1:8002/mcp
# CHAT_LOG_DIR=chat_logs

# API chat cho web (python main_chat.py, SSE) -- cũng cần GEMINI_API_KEY và MCP_SERVER_URL ở trên
# CHAT_API_HOST=127.0.0.1
# CHAT_API_PORT=8003
# CHAT_DEMO_ENABLED=true              # công tắc tắt: false thì /chat/status báo enabled=false và /chat/stream trả 503 (compose: tạo lại container bằng `docker compose --profile chat up -d`)
# CHAT_MAX_QUESTION_CHARS=500         # câu hỏi dài hơn bị từ chối (422 too_long)
# CHAT_MAX_TURNS_PER_SESSION=30       # số lượt hỏi tối đa của một phiên
# CHAT_SESSION_TTL_SECONDS=1800       # phiên không hoạt động quá thời gian này sẽ bị xoá
# CHAT_MAX_SESSIONS=200               # số phiên đồng thời tối đa

# Hỏi đáp chính sách (RAG, docs/rag.md) -- tuỳ chọn: cần Milvus (docker compose --profile rag) và GEMINI_API_KEY ở trên
# Mỗi biến ghi rõ áp dụng cho compose, host (chạy python trực tiếp) hay cả hai.
# MILVUS_URI=http://127.0.0.1:19530   # CHỈ HOST: docker compose không dùng biến này (mcp/policy-seed luôn nối http://milvus:19530)
# MILVUS_TOKEN=                       # CHỈ HOST: token nếu Milvus bật xác thực (demo không bật; compose không chuyển vào container)
# MILVUS_COLLECTION=policy_chunks     # compose và host: tên collection; policy-seed và mcp phải trùng
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001   # compose và host: đổi model thì phải chạy lại: python -m app.cli ingest-policies data/policies --prune
# POLICY_MIN_SCORE=0.0                # compose (chỉ mcp) và host: bỏ đoạn có điểm cosine thấp hơn; 0 = không lọc (chưa hiệu chỉnh với model thật); hợp lệ trong [-1, 1]

# LOG_LEVEL=INFO
