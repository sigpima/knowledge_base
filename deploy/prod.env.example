# Mẫu .env cho SERVER (copy thành ~/knowledge-base/.env rồi chmod 600). Khác với .env.example ở gốc repo (dùng để chạy trên máy dev).
# Không bao giờ commit file .env thật.

# Hai file compose ghép lại (bản demo + override cho server) và các service tuỳ chọn bật mặc định.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
COMPOSE_PROFILES=chat

# latest = bản mới nhất của main; sha-abc1234 = đúng một bản build (dùng để rollback). `./update.sh sha-abc1234` ghim chỉ cho một lần chạy.
IMAGE_TAG=latest

# Tạo bằng: openssl rand -hex 16   (tránh ký tự $: compose coi là biến)
# POSTGRES_PASSWORD chỉ có tác dụng lần khởi tạo đầu của volume; đổi sau này phải `docker compose down -v`.
POSTGRES_PASSWORD=
RO_PASSWORD=

# Khoá Gemini cho service chat (bắt buộc khi COMPOSE_PROFILES có chat). Nên đặt hạn mức/budget cho khoá trong Google AI Studio.
GEMINI_API_KEY=

# Tuỳ chọn: công tắc tắt khẩn cấp (đổi xong chạy lại ./update.sh), giới hạn phiên chat. Xem README, mục "API chat cho web".
# CHAT_DEMO_ENABLED=true
# CHAT_MAX_TURNS_PER_SESSION=30
# CHAT_MAX_SESSIONS=200

# Tuỳ chọn: bật RAG chính sách (thêm milvus + policy-seed, nặng hơn): COMPOSE_PROFILES=chat,rag
